{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "executive_summary",
    "findings",
    "prd_status",
    "edd_status",
    "issue_pr_provenance_status",
    "test_confidence",
    "architecture_status",
    "derived_doc_status",
    "agent_infrastructure_assessment",
    "issue_candidates",
    "recommended_next_actions"
  ],
  "properties": {
    "executive_summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "severity",
          "category",
          "evidence",
          "expected_behavior",
          "actual_behavior",
          "why_it_matters",
          "recommended_action",
          "confidence"
        ],
        "properties": {
          "title": {"type": "string"},
          "severity": {"enum": ["Critical", "High", "Medium", "Low"]},
          "category": {
            "enum": [
              "PRD Compliance",
              "EDD Compliance",
              "Work Contract Compliance",
              "Delivery Provenance",
              "Architecture Drift",
              "Test Adequacy",
              "Derived Documentation Drift",
              "Agent Infrastructure",
              "Accidental Complexity",
              "Source-of-Truth Ambiguity"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "expected_behavior": {"type": "string"},
          "actual_behavior": {"type": "string"},
          "why_it_matters": {"type": "string"},
          "recommended_action": {"type": "string"},
          "confidence": {"enum": ["High", "Medium", "Low"]}
        }
      }
    },
    "prd_status": {"type": "string"},
    "edd_status": {"type": "string"},
    "issue_pr_provenance_status": {"type": "string"},
    "test_confidence": {"type": "string"},
    "architecture_status": {"type": "string"},
    "derived_doc_status": {"type": "string"},
    "agent_infrastructure_assessment": {"type": "string"},
    "issue_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_title", "eligible", "reason"],
        "properties": {
          "finding_title": {"type": "string"},
          "eligible": {"type": "boolean"},
          "reason": {"type": "string"}
        }
      }
    },
    "recommended_next_actions": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
